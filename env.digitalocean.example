# DigitalOcean Droplet Environment Variables
# Copy this to server/.env and update with your values

# ============================================
# Database Configuration
# ============================================

# Option 1: Self-hosted PostgreSQL (on same droplet)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadrouter
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Option 2: DigitalOcean Managed Database (recommended for production)
# Uncomment and use this instead of DB_* variables above:
# DATABASE_URL=postgresql://user:password@db-postgresql-nyc3-12345.db.ondigitalocean.com:25060/dbname?sslmode=require

# ============================================
# Application Configuration
# ============================================

NODE_ENV=production
PORT=3001

# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET=your-random-jwt-secret-here-change-this

# Client URL - Your domain or droplet IP
CLIENT_URL=http://your-droplet-ip:3001
# OR with domain:
# CLIENT_URL=https://yourdomain.com

# Frontend API URL - Empty string for same origin
REACT_APP_API_URL=

# ============================================
# Authentication
# ============================================

# MUST be false in production!
BYPASS_AUTH=false

# ============================================
# User Passwords (Optional)
# ============================================

# Default admin password (change after first login!)
ADMIN_PASSWORD=admin123

# Default BDR password (change after first login!)
BDR_PASSWORD=bdr123

# ============================================
# HubSpot Integration (Optional)
# ============================================

# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=
