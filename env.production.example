# LeadRouter Production Environment Variables
# Copy this file to .env and update with your production values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Option 1: MongoDB Atlas (Recommended for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/leadrouter?appName=leadrouter

# Option 2: Local MongoDB (for Docker/local development)
# DB_HOST=mongo
# DB_PORT=27017
# DB_NAME=leadrouter
# DB_USER=admin
# DB_PASSWORD=your_secure_database_password_here

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3001
APP_PORT=3001

# IMPORTANT: Generate a strong random secret for JWT
# Run: openssl rand -base64 32
JWT_SECRET=your-very-secure-random-jwt-secret-here-change-this

# Your production domain (with https://)
CLIENT_URL=https://yourdomain.com

# ============================================
# HUBSPOT INTEGRATION (Optional)
# ============================================
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret

# ============================================
# SECURITY SETTINGS
# ============================================
# Set to false in production to require authentication
BYPASS_AUTH=false

# ============================================
# DEFAULT USER PASSWORDS (Change after first login!)
# ============================================
# Admin user default password (change after first login)
ADMIN_PASSWORD=admin123

# BDR user default password (change after first login)
BDR_PASSWORD=bdr123

